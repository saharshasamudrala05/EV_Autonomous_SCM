# ─────────────────────────────────────────────────
# NEXUS-SCM  |  Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# ── Database ──────────────────────────────────────
# Docker PostgreSQL (port 5433 avoids conflict with local PG on 5432)
DATABASE_URL=postgresql://nexus:nexus123@localhost:5433/nexus_scm

# Alternative: point to your existing local PostgreSQL
# DATABASE_URL=postgresql://postgres:saharsha@localhost:5432/nexus_scm

# ── Kafka ─────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_GROUP_ID=nexus-scm-consumer
ENABLE_KAFKA=true

# ── Kafka Topics ──────────────────────────────────
TOPIC_DEMAND=ev.demand.signals
TOPIC_SUPPLY=ev.supply.events
TOPIC_SHIPMENT=ev.shipment.events
TOPIC_PRICE=ev.price.events

# ── Application ───────────────────────────────────
APP_NAME=NEXUS-SCM
APP_VERSION=1.0.0
DEBUG=true
API_PORT=8000

# ── Paths ─────────────────────────────────────────
DATA_DIR=../
